#!/usr/bin/env bash
# Reject a push that contains a commit whose message breaks the convention
# in README.md. Enable once per clone:  git config core.hooksPath .githooks
#
# Git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

checker="$(git rev-parse --show-toplevel)/scripts/check-commit-msg.sh"
remote=$1
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

# shellcheck disable=SC2034  # local_ref and remote_ref are part of the protocol
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ $local_sha == "$zero" ]] && continue          # branch deletion
  if [[ $remote_sha == "$zero" ]]; then
    # New branch: check only commits that the remote does not have yet.
    "$checker" --revs "$local_sha" --not --remotes="$remote" || status=1
  else
    "$checker" --revs "$remote_sha..$local_sha" || status=1
  fi
done

if (( status )); then
  echo >&2
  echo "Push rejected: fix the commit messages above, then push again." >&2
fi
exit $status
